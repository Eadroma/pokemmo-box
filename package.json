{
  "name": "pokemmo-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "data": "node scripts/build-data.mjs && node scripts/build-hordes.mjs && node scripts/build-sets.mjs",
    "test": "node --test test/*.test.ts",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "jsonc-eslint-parser": "^3.3.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "yaml-eslint-parser": "^2.1.0"
  }
}
